# Android 正式发布包签名配置示例模版
# 使用说明:
# 1. 复制本文件并重命名为: key.properties
# 2. 将下方的路径和密码修改为您使用 keytool 生成的真实密钥信息:
#    keytool -genkey -v -keystore authix-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias authix_key

storePassword=your_keystore_password
keyPassword=your_key_password
keyAlias=authix_key
storeFile=authix-release.jks
